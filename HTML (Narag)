<div class="pageBlur" id="pageBlur"></div>

<div class="gcashToast" id="gcashToast">
  <div class="gcashToastBox">
    <div class="gcashToastTitle">Redirecting to GCash</div>
    <div class="gcashToastText">
      You will be redirected to GCash to complete your payment.
      <br><br>
      After completing payment, return to this tab to see your order confirmation.
    </div>
    <div class="gcashToastFooter">
      Redirecting<span class="gcashDots"><span>.</span><span>.</span><span>.</span></span>
    </div>
  </div>
</div>

<button class="btn1" id="btn1">Open Cart</button>

<div class="containerWrap">

  <div class="box1" id="box1">
    <div class="cartHead">
      <h2>Cart</h2>
      <button class="btnX" id="btnX">✖</button>
    </div>

    <div class="cartScroll">
      <div class="cartItems" id="cartItems">

        <div class="cartItem" data-price="10.00" data-name="Item 1" data-desc="Description">
          <button class="removeBtn" title="Remove">✖</button>
          <div class="itemInfo">
            <span class="itemName">Item 1</span>
            <span class="itemDesc">Description</span>
          </div>
          <div class="qty">
            <button class="minus" disabled>−</button>
            <span class="qtyNum">1</span>
            <button class="plus">+</button>
          </div>
          <span class="itemPrice">₱10.00</span>
        </div>

        <div class="cartItem" data-price="20.00" data-name="Item 2" data-desc="Description">
          <button class="removeBtn" title="Remove">✖</button>
          <div class="itemInfo">
            <span class="itemName">Item 2</span>
            <span class="itemDesc">Description</span>
          </div>
          <div class="qty">
            <button class="minus" disabled>−</button>
            <span class="qtyNum">1</span>
            <button class="plus">+</button>
          </div>
