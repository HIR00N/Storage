<script>

  const pageBlur = document.getElementById('pageBlur');

  function showBlur() {
    pageBlur.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function hideBlur() {
    pageBlur.classList.remove('show');
    document.body.style.overflow = '';
  }

  const btn1 = document.getElementById('btn1');
  const box1 = document.getElementById('box1');
  const btnX = document.getElementById('btnX');
  const cartScroll = document.querySelector('.cartScroll');
  const cartItems = document.getElementById('cartItems');
  const emptyCart = document.getElementById('emptyCart');
  const subtotalEl = document.getElementById('subtotal');
  const deliveryEl = document.getElementById('delivery');
  const grandTotalEl = document.getElementById('grandTotal');

  const checkoutBtn = document.getElementById('checkoutBtn');
  const box2 = document.getElementById('box2');
  const backBtn = document.getElementById('backBtn');
  const checkoutTotalEl = document.getElementById('checkoutTotal');
  const placeOrderBtn = document.getElementById('placeOrderBtn');

  const box3 = document.getElementById('box3');
  const successBody = document.getElementById('successBody');
  const successText = document.getElementById('successText');
  const viewOrderBtn = document.getElementById('viewOrderBtn');
  const homeBtn = document.getElementById('homeBtn');
  const orderInfo = document.getElementById('orderInfo');
  const orderInfoBackBtn = document.getElementById('orderInfoBackBtn');

  const checkoutScroll = document.querySelector('.checkoutScroll');
  const checkoutBody = document.getElementById('checkoutBody');

  const BASE_DELIVERY = 10.00;
  const DELIVERY_STEP = 3.00;
  const MIN_QTY = 1;

  const GCASH_RETURN_KEY = 'gcashOrderPending';

  let lastOrderSnapshot = null;

  function closeAllBoxes() {
    box1.classList.remove('show');
    box2.classList.remove('show');
    box3.classList.remove('show');
  }

  function openCart() {
    closeAllBoxes();
    box1.classList.add('show');
    showBlur();
    setTimeout(updateFades, 50);
  }

  function toggleCart() {
    if (box1.classList.contains('show')) {
      box1.classList.remove('show');
      if (!box2.classList.contains('show') && !box3.classList.contains('show')) {
        hideBlur();
      }
    } else {
      openCart();
    }
  }

  /* Primary handler */
  btn1.addEventListener('click', function (e) {
    e.preventDefault();
    toggleCart();
  });

  /*
    Safety net: if for ANY reason the button's own click doesn't fire
    (e.g. some overlay intercepts it), we detect a click within the
    button's bounding box and treat it as a button click.
    This guarantees the cart opens after "Back to Home".
  */
  document.addEventListener('click', function (e) {
    // If the click already reached the button, do nothing (handled above)
    if (e.target === btn1 || btn1.contains(e.target)) return;

    // If a cart box is open, don't hijack clicks
    if (box1.classList.contains('show') || box2.classList.contains('show') || box3.classList.contains('show')) return;

    const r = btn1.getBoundingClientRect();
    const x = e.clientX;
    const y = e.clientY;

    if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) {
      openCart();
    }
  }, true);

  btnX.addEventListener('click', function () {
    box1.classList.remove('show');
    hideBlur();
  });

  checkoutBtn.addEventListener('click', function () {
    if (document.querySelectorAll('.cartItem').length === 0) return;

    box1.classList.remove('show');
    box2.classList.add('show');
    box3.classList.remove('show');
    setTimeout(updateCheckoutFades, 50);
  });

  backBtn.addEventListener('click', function () {
    box2.classList.remove('show');
    box1.classList.add('show');
    setTimeout(updateFades, 50);
  });

  viewOrderBtn.addEventListener('click', function () {
    successBody.style.display = 'none';
    orderInfo.classList.add('show');
  });

  orderInfoBackBtn.addEventListener('click', function () {
    orderInfo.classList.remove('show');
    successBody.style.display = 'flex';
  });

  homeBtn.addEventListener('click', function () {
    closeAllBoxes();
    hideBlur();
    successBody.style.display = 'flex';
    orderInfo.classList.remove('show');
    /* Force-restore page interactivity */
    document.body.style.overflow = '';
    document.body.style.pointerEvents = '';
  });

  function formatMoney(n) {
    return '₱' + n.toFixed(2);
  }

  function getSubtotalAndQty() {
    let subtotal = 0;
    let totalQty = 0;

    document.querySelectorAll('.cartItem').forEach(function (item) {
      const price = parseFloat(item.dataset.price);
      const qty = parseInt(item.querySelector('.qtyNum').textContent, 10);
      subtotal += price * qty;
      totalQty += qty;
    });

    return { subtotal, totalQty };
  }

  function getDelivery(subtotal, totalQty) {
    if (subtotal <= 0 || totalQty <= 0) return 0;
    const extraItems = Math.max(0, totalQty - 1);
    return BASE_DELIVERY + (extraItems * DELIVERY_STEP);
  }

  function updateEmptyState() {
    const hasItems = document.querySelectorAll('.cartItem').length > 0;
    emptyCart.classList.toggle('show', !hasItems);
    document.querySelector('.cartFoot').style.display = hasItems ? '' : 'none';
  }

  function updateTotals() {
    const { subtotal, totalQty } = getSubtotalAndQty();
    const delivery = getDelivery(subtotal, totalQty);
    const total = subtotal + delivery;

    subtotalEl.textContent = formatMoney(subtotal);
    deliveryEl.textContent = formatMoney(delivery);
    grandTotalEl.textContent = formatMoney(total);
    checkoutTotalEl.textContent = formatMoney(total);

    updateEmptyState();
    updateFades();
  }

  function updateRowPrice(item) {
    const price = parseFloat(item.dataset.price);
    const qty = parseInt(item.querySelector('.qtyNum').textContent, 10);
    item.querySelector('.itemPrice').textContent = formatMoney(price * qty);
  }

  function updateMinusState(item) {
    const qty = parseInt(item.querySelector('.qtyNum').textContent, 10);
    const minusBtn = item.querySelector('.minus');
    minusBtn.disabled = qty <= MIN_QTY;
  }

  cartItems.addEventListener('click', function (e) {
    const item = e.target.closest('.cartItem');
    if (!item) return;

    if (e.target.classList.contains('plus')) {
      const qtyEl = item.querySelector('.qtyNum');
      qtyEl.textContent = parseInt(qtyEl.textContent, 10) + 1;
      updateRowPrice(item);
      updateMinusState(item);
      updateTotals();
    }

    if (e.target.classList.contains('minus')) {
      const qtyEl = item.querySelector('.qtyNum');
      const current = parseInt(qtyEl.textContent, 10);

      if (current <= MIN_QTY) return;

      qtyEl.textContent = current - 1;
      updateRowPrice(item);
      updateMinusState(item);
      updateTotals();
    }

    if (e.target.classList.contains('removeBtn')) {
      item.remove();
      updateTotals();
    }
  });

  function updateFades() {
    const hasItems = document.querySelectorAll('.cartItem').length > 0;

    if (!hasItems) {
      cartScroll.classList.remove('can-scroll-up', 'can-scroll-down');
      return;
    }

    const scrollTop = cartItems.scrollTop;
    const scrollHeight = cartItems.scrollHeight;
    const clientHeight = cartItems.clientHeight;

    const canScrollUp = scrollTop > 0;
    const canScrollDown = scrollTop + clientHeight < scrollHeight - 1;

    cartScroll.classList.toggle('can-scroll-up', canScrollUp);
    cartScroll.classList.toggle('can-scroll-down', canScrollDown);
  }

  function updateCheckoutFades() {
    const scrollTop = checkoutBody.scrollTop;
    const scrollHeight = checkoutBody.scrollHeight;
    const clientHeight = checkoutBody.clientHeight;

    const canScrollUp = scrollTop > 0;
    const canScrollDown = scrollTop + clientHeight < scrollHeight - 1;

    checkoutScroll.classList.toggle('can-scroll-up', canScrollUp);
    checkoutScroll.classList.toggle('can-scroll-down', canScrollDown);
  }

  cartItems.addEventListener('scroll', updateFades);
  checkoutBody.addEventListener('scroll', updateCheckoutFades);
  window.addEventListener('resize', function () {
    updateFades();
    updateCheckoutFades();
  });

  document.querySelectorAll('.cartItem').forEach(updateMinusState);
  updateTotals();

  const fields = {
    name:    { el: document.getElementById('fullName'), group: 'fg-name',    type: 'text'  },
    house:   { el: document.getElementById('houseNo'),  group: 'fg-house',   type: 'text'  },
    street:  { el: document.getElementById('street'),   group: 'fg-street',  type: 'text'  },
    city:    { el: document.getElementById('city'),     group: 'fg-city',    type: 'text'  },
    zip:     { el: document.getElementById('zip'),      group: 'fg-zip',     type: 'text'  },
    phone:   { el: document.getElementById('phone'),    group: 'fg-phone',   type: 'phone' },
    email:   { el: document.getElementById('email'),    group: 'fg-email',   type: 'email' },
    payment: { el: document.getElementById('payment'),  group: 'fg-payment', type: 'select'}
  };

  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  }

  function isValidPhone(v) {
    const digits = v.replace(/[\s\-()+]/g, '');
    return /^\d{11}$/.test(digits);
  }

  function setInvalid(group, invalid) {
    const g = document.getElementById(group);
    g.classList.toggle('invalid', invalid);
  }

  function validateField(key) {
    const f = fields[key];
    const value = (f.el.value || '').trim();
    let ok = true;

    if (!value) {
      ok = false;
    } else if (f.type === 'email') {
      ok = isValidEmail(value);
    } else if (f.type === 'phone') {
      ok = isValidPhone(value);
    }

    setInvalid(f.group, !ok);
    return ok;
  }

  Object.keys(fields).forEach(function (key) {
    const f = fields[key];
    const evt = f.type === 'select' ? 'change' : 'input';
    f.el.addEventListener(evt, function () {
      const group = document.getElementById(f.group);
      if (group.classList.contains('invalid')) {
        validateField(key);
      }
    });
  });

  function snapshotOrder() {
    const items = [];
    document.querySelectorAll('.cartItem').forEach(function (item) {
      const itemName = item.dataset.name || item.querySelector('.itemName').textContent;
      const price = parseFloat(item.dataset.price);
      const qty = parseInt(item.querySelector('.qtyNum').textContent, 10);
      items.push({ name: itemName, price: price, qty: qty });
    });

    const { subtotal, totalQty } = getSubtotalAndQty();
    const delivery = getDelivery(subtotal, totalQty);

    lastOrderSnapshot = {
      name: fields.name.el.value.trim(),
      house: fields.house.el.value.trim(),
      street: fields.street.el.value.trim(),
      city: fields.city.el.value.trim(),
      zip: fields.zip.el.value.trim(),
      phone: fields.phone.el.value.trim(),
      email: fields.email.el.value.trim(),
      payment: fields.payment.el.value,
      items: items,
      subtotal: subtotal,
      delivery: delivery,
      total: subtotal + delivery
    };

    return lastOrderSnapshot;
  }

  function fillOrderInfo() {
    const o = lastOrderSnapshot || snapshotOrder();
    const paymentLabel = o.payment === 'gcash' ? 'GCash' : 'Cash on Delivery';

    document.getElementById('oi-name').textContent = o.name;
    document.getElementById('oi-address').textContent =
      o.house + ' ' + o.street + ', ' + o.city + ' ' + o.zip;
    document.getElementById('oi-phone').textContent = o.phone;
    document.getElementById('oi-email').textContent = o.email;
    document.getElementById('oi-payment').textContent = paymentLabel;

    const itemsContainer = document.getElementById('oi-items');
    itemsContainer.innerHTML = '';
    o.items.forEach(function (it) {
      const row = document.createElement('div');
      row.className = 'orderItemRow';
      row.innerHTML =
        '<span>' + it.name + ' <span class="qtyLabel">× ' + it.qty + '</span></span>' +
        '<span>' + formatMoney(it.price * it.qty) + '</span>';
      itemsContainer.appendChild(row);
    });

    document.getElementById('oi-subtotal').textContent = formatMoney(o.subtotal);
    document.getElementById('oi-delivery').textContent = formatMoney(o.delivery);
    document.getElementById('oi-total').textContent = formatMoney(o.total);
  }

  function clearCart() {
    cartItems.innerHTML = '';
    updateTotals();
  }

  function showSuccess(message) {
    successBody.style.display = 'flex';
    orderInfo.classList.remove('show');

    successText.textContent = message;

    fillOrderInfo();

    box1.classList.remove('show');
    box2.classList.remove('show');
    box3.classList.add('show');

    clearCart();

    showBlur();
  }

  placeOrderBtn.addEventListener('click', function () {
    let allValid = true;

    Object.keys(fields).forEach(function (key) {
      const ok = validateField(key);
      if (!ok) allValid = false;
    });

    if (!allValid) {
      const firstInvalid = document.querySelector('.formGroup.invalid');
      if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    snapshotOrder();

    const method = fields.payment.el.value;

    if (method === 'gcash') {
      sessionStorage.setItem(GCASH_RETURN_KEY, 'true');
      sessionStorage.setItem('lastOrderSnapshot', JSON.stringify(lastOrderSnapshot));

      showGcashToast();

      setTimeout(function () {
        hideGcashToast();
        window.open('https://www.gcash.com/', '_blank');
        onGcashReturn();
      }, 5000);
    } else if (method === 'cod') {
      showSuccess(
        'Your Cash on Delivery order has been placed. Please prepare the exact amount upon delivery.'
      );
    }
  });

  function onGcashReturn() {
    if (sessionStorage.getItem(GCASH_RETURN_KEY) === 'true') {
      sessionStorage.removeItem(GCASH_RETURN_KEY);

      const saved = sessionStorage.getItem('lastOrderSnapshot');
      if (saved) {
        try { lastOrderSnapshot = JSON.parse(saved); } catch (e) {}
        sessionStorage.removeItem('lastOrderSnapshot');
      }

      showSuccess('Payment via GCash was successful! Track your order below.');
    }
  }

  window.addEventListener('load', function () {
    setTimeout(onGcashReturn, 100);
  });

  function showGcashToast() {
    document.getElementById('gcashToast').classList.add('show');
    showBlur();
  }

  function hideGcashToast() {
    document.getElementById('gcashToast').classList.remove('show');
  }

</script>

</body>
</html>
