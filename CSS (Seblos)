:root {
    --pink-light: #fde8ef;
    --white: #ffff;
    --pink: #B8325A;
    --pink-dark: #b83b66;
    --text-dark: #4a2c36;
    --font-main: 'Poppins', sans-serif;
    --1212: #fef0f5;
    --checker: black;
    --p: #FFB2C4;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#id {
    font-family: var(--font-main);
    color: var(--text-dark);

}

.site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 60px;
    /* 10 px 60 px */
    background-color: #E86A91;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.26);
}

.nav-links img {
    display: block;
    /* removes the tiny space below inline images */

}

.nav-links a {
    align-items: center;
    display: inline-flex;
    padding: 0 20px;
    height: 52px;
    box-sizing: border-box;
    background-color: #bd2e5c;
    /* CHANGED: was #a7a7a7 (grey), now the active color */
    color: #ffffff;
    /* red-pink text, replaces var(--white) */
    font-family: Georgia, serif;
    font-size: 16px;
    text-decoration: none;
    border-radius: 15px;
    border-bottom: 4px solid var(--text-dark);
    transition: border-color 0.15s, box-shadow 0.15s;
}

.nav-links a:hover {
    background-color: #a92755;
    border-bottom-color: color-mix(in srgb, var(--text-dark) 50%, transparent);

    box-shadow: none;
    /* CHANGED: removes the grey ring on hover */

}

.nav-links {
    align-items: center;
    display: flex;
    margin: 0;
    padding: 0;
    gap: 20px;
    /* space between each link */
    height: 30px;
    list-style: none;
    font-family: calibri;

}

.logo {
    height: 60px;
    /*60 px */
}


.drop {
    padding: 10px 0px;
}

.About {
    display: flex;
    align-items: center;

}

.About img {
    position: absolute;
    width: 170px;
    height: 270px;
    border: 5px solid;
    border-color: #b83251;
    border-radius: 10px;
}

.About img:nth-child(1) {
    margin-left: 170px;
    margin-top: 70px;
    transform: rotate(10deg);
    z-index: 1;
}

.About img:nth-child(2) {
    margin-left: 70px;
    margin-top: 230px;
    transform: rotate(-10deg);
    z-index: 2;
}

.About img:nth-child(3) {
    margin-left: 170px;
    margin-top: 530px;
    transform: rotate(15deg);
    z-index: 3;
}


