
.Heading {
    padding: 0%;
    margin: 0%;
    background-color: white;
}

.Heading img {
    width: 200px;
    height: 100px;
    padding: 0%;
    margin: 0%;
    background-color: white;
    margin-right: 40%;
    vertical-align: middle;

}

.Heading p {
    display: inline;
    height: 50%;
    padding: 25px;
    color: #b83251;
    font-family: sans-serif;
}

.About {
    display: flex;
    align-items: center;

}

.About img {
    position: absolute;
    width: 170px;
    height: 270px;
    border: 5px solid;
    border-color: #b83251;
    border-radius: 10px;
}

.About img:nth-child(1) {
    margin-left: 170px;
    margin-top: 10px;
    transform: rotate(10deg);
    z-index: 1;
}

.About img:nth-child(2) {
    margin-left: 70px;
    margin-top: 170px;
    transform: rotate(-10deg);
    z-index: 2;
}

.About img:nth-child(3) {
    margin-left: 170px;
    margin-top: 470px;
    transform: rotate(15deg);
    z-index: 3;
}


