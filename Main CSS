:root {
  --hp:            #E86A91;  /* header + footer pink */
  --accent:        #bd2e5c;  /* nav links, cart button, active tab */
  --accent-dark:   #9e234b;  /* cart button hover */
  --accent-select: #993055;  /* selected nav link */
  --accent-hover:  #db3469;  /* nav link hover */
  --heading:       #a92755;  /* section/menu titles, tab text */
  --text-pink:     #b52e5b;  /* body text, food name/price */
  --tab-bg:        #f9cbd8;
  --text-dark:     #4a2c36;
  --line:          rgba(255, 255, 255, 0.45);  /* footer divider lines */
  --font-main:  'Poppins', sans-serif;
  --font-title: "Timmana", sans-serif;
  --font-serif: "Jaini", serif;

  --arrow-offset: -20px;   /* negative = further OUTSIDE the row */
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

body {
  background-color: #fff5f5;
  font-family: Arial, sans-serif;
  color: var(--text-pink);
}

main {
  flex: 1;
}

h1, h2, h3 {
  font-family: var(--font-main);
}


/* ============================== HEADER ============================== */
.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  background-color: var(--hp);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.26);
}

.logo {
  height: 60px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
  height: 30px;
  list-style: none;
  font-family: var(--font-title);
}

.nav-links img {
  display: block;
  position: relative;
  top: -4px;
}

.nav-links a {
  display: inline-flex;
  align-items: center;
  height: 52px;
  padding: 10px 20px 0;
  background-color: var(--accent);
  color: #fff;
  font-size: 16px;
  text-decoration: none;
  border-radius: 15px;
  border-bottom: 4px solid var(--text-dark);
}

a.Selected {
  background-color: var(--accent-select);
  border-bottom: 0;
  box-shadow: 0 10px 10px rgba(20, 3, 5, 0.26);
  color: #000;
}

.nav-links a:hover {
  background-color: var(--accent-hover);
  border-bottom-color: color-mix(in srgb, var(--text-dark) 50%, transparent);
  border-radius: 20px;
  padding: 10px 20px;
  font-size: 18px;
  font-weight: bold;
  box-shadow: none;
}


/* ============================== FOOTER ============================== */

.footer {
  background: var(--hp);
  color: #fff;
  padding: 28px 5% 12px;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.4fr 1.2fr 1.2fr 1.5fr;
  align-items: start;
}

.footer-logo img {
  width: 190px;
  height: auto;
  display: block;
  filter: brightness(0) invert(1);  /* makes the pink logo appear white */
}

.footer-column {
  min-height: 80px;
  border-left: 1px solid var(--line);
  padding-left: 35px;
}

.footer-column h3 {
  font-size: 15px;
  margin-bottom: 8px;
}

.footer-column a {
  display: block;
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  line-height: 19px;
  transition: 0.2s;
}

.footer-column a:hover {
  opacity: 0.7;
}

.social-icons {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 10px;
}

.social-link img {
  width: 28px;
  height: 28px;
  object-fit: contain;
  display: block;
}

.contact-column p {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
  font-size: 12px;
}

.icon {
  width: 18px;
  font-size: 15px;
  text-align: center;
}

.footer-bottom {
  max-width: 1200px;
  margin: 15px auto 0;
  padding-top: 12px;
  border-top: 1px solid var(--line);
  text-align: center;
}

.footer-bottom p {
  font-size: 11px;
}

.heart {
  font-size: 16px;
  margin-left: 5px;
}


/* ============================ MAIN CONTENT =========================== */

.banner {
  width: 1200px;
  height: 400px;
  margin: 0 auto;
  background-image: url("BANNER.jpg");
  background-repeat: no-repeat;
  background-position: center;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 30px;
}

.section-title,
.menu-title {
  font-size: 32px;
  font-weight: bold;
  color: var(--heading);
}

.section-title {
  font-family: var(--font-title);
  margin: 0 0 20px 20px;
}

.menu-title {
  font-family: var(--font-serif);
}


/* ============================== CAROUSEL ============================= */

.carousel {
  position: relative;
  anchor-scope: --food-row;      /* each carousel gets its own anchor */
  timeline-scope: --row-scroll;  /* ...and its own scroll timeline */
}

/* edge fades */
.carousel::before,
.carousel::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 10%;
  pointer-events: none;
  z-index: 1;
}

.carousel::before {
  left: 0;
  background: linear-gradient(to left, transparent, #fff5f5);
  opacity: 0;   /* hidden until you scroll */
}

.carousel::after {
  right: 0;
  background: linear-gradient(to right, transparent, #fff5f5);
}

@keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }
@keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }

@supports (animation-timeline: scroll()) {
  .carousel::before {
    animation: fade-in linear both;
    animation-timeline: --row-scroll;
    animation-range: 0px 150px;
  }

  .carousel::after {
    animation: fade-out linear both;
    animation-timeline: --row-scroll;
    animation-range: calc(100% - 150px) 100%;
  }
}

/* native scroll buttons (Chrome 135+) */
.carousel .food-row::scroll-button(*) {
  position: fixed;
  position-anchor: --food-row;
  top: anchor(center);
  translate: 0 -50%;
  z-index: 2;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  transition: 0.2s;
}

.carousel .food-row::scroll-button(left) {
  content: "\276E" / "Scroll left";
  left: calc(anchor(left) + var(--arrow-offset));
}

.carousel .food-row::scroll-button(right) {
  content: "\276F" / "Scroll right";
  right: calc(anchor(right) + var(--arrow-offset));
}

.carousel .food-row::scroll-button(*):hover:not(:disabled) {
  background-color: var(--accent-dark);
}

.carousel .food-row::scroll-button(*):disabled {
  opacity: 0.35;
  cursor: default;
}

.food-row {
  display: flex;
  gap: 25px;
  margin-bottom: 35px;
  padding: 4px 0 16px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  anchor-name: --food-row;
  scroll-timeline: --row-scroll x;
  scrollbar-width: auto;
  scrollbar-color: var(--accent) var(--tab-bg);
  overscroll-behavior-x: contain;
}

.food-card {
  flex: 0 0 calc((100% - 75px) / 3.35);   /* 3 cards + a peek of the 4th */
  scroll-snap-align: start;
  padding: 10px;
  background-color: #fff;
  border-radius: 15px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.food-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 25px;
  display: block;
}

/* Fallback arrows (anchor links) for browsers without ::scroll-button */
.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 44px;
  height: 44px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  transition: 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
}

.arrow:hover { background-color: var(--accent-dark); }
.arrow-left  { left: -32px; }
.arrow-right { right: -32px; }

#today-first,
#today-last,
#menu-first,
#menu-last {
  scroll-margin-top: 150px;   /* only matters for the fallback arrows */
}

/* hide the fallback arrows when native buttons exist (block is closed right away) */
@supports selector(::scroll-button(left)) {
  .arrow { display: none; }
}


/* ====================== "SELECT MORE" CARD + POP-UP ================== */

.more-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 220px;
  font: inherit;
  cursor: pointer;
  text-decoration: none;
  color: var(--heading);
  background-color: var(--tab-bg);
  border: 2px dashed var(--accent);
  transition: 0.2s;
}

.more-icon {
  display: grid;
  place-items: center;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 22px;
}

.more-text {
  font-size: 18px;
  font-weight: bold;
}

.more-card:hover {
  background-color: var(--accent);
  color: #fff;
}

.more-card:hover .more-icon {
  background-color: #fff;
  color: var(--accent);
}

.more-popup {
  margin: auto;                    /* centers it on screen */
  min-width: 80vw;                 /* at least 80% of the screen width */
  min-height: 80vh;                /* at least 80% of the screen height */
  max-width: 90vw;
  max-height: 90vh;
  overflow-y: auto;                /* long content scrolls inside the pop-up */
  padding: 30px;
  border: none;
  border-radius: 20px;
  background-color: #fff5f5;
  color: var(--text-pink);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.more-popup h2 {
  color: var(--heading);
  margin-bottom: 10px;
}

/* the blurred background */
.more-popup::backdrop {
  background: rgba(74, 44, 54, 0.35);
  backdrop-filter: blur(6px);
}

.popup-close {
  position: absolute;
  top: 12px;
  right: 14px;
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 50%;
  background-color: var(--accent);
  color: #fff;
  font-size: 22px;
  cursor: pointer;
}

.popup-close:hover {
  background-color: var(--accent-dark);
}

/* stops the page scrolling behind the pop-up */
body:has(.more-popup:popover-open) {
  overflow: hidden;
}


/* ============================ MENU / CARDS =========================== */

.food-info {
  padding: 12px 10px;
  font-size: 20px;
  color: var(--text-pink);
}

.food-name {
  font-weight: 500;
}

.price {
  margin-top: 2px;
}

.cart-btn {
  background-color: var(--accent);
  color: #fff;
  text-align: center;
  padding: 10px;
  border-radius: 10px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.2s;
}

.cart-btn:hover {
  background-color: var(--accent-dark);
}

.menu-header {
  display: flex;
  align-items: center;
  gap: 35px;
  margin: 10px 0 25px 20px;
}

.menu-tabs {
  display: flex;
  gap: 10px;
}

.tab {
  background-color: var(--tab-bg);
  color: var(--heading);
  padding: 10px 20px;
  border-radius: 15px;
  font-family: var(--font-serif);
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.tab:hover,
.tab.active {
  background-color: var(--accent);
  color: #fff;
}


/* ====================== RESPONSIVE: KEEP THESE LAST ================== */

@media (max-width: 900px) {
  .food-card { flex: 0 0 calc((100% - 50px) / 2.35); }

  .menu-header {
    margin-left: 0;
    flex-wrap: wrap;
  }
}

@media (max-width: 850px) {
  .footer-container {
    grid-template-columns: 1fr 1fr;
    row-gap: 30px;
  }

  .footer-column { padding-left: 25px; }
}

@media (max-width: 600px) {
  :root { --arrow-offset: 6px; }   /* keeps the native arrows on-screen */

  .container { padding: 15px; }

  .food-card { flex: 0 0 80%; }
  .food-card img { height: 230px; }

  .arrow { width: 36px; height: 36px; font-size: 14px; }
  .arrow-left  { left: -6px; }
  .arrow-right { right: -6px; }

  .menu-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .menu-tabs { flex-wrap: wrap; }
}

@media (max-width: 550px) {
  .footer {
    padding: 30px 25px 15px;
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .footer-logo {
    padding-bottom: 5px;
  }

  .footer-logo img {
    width: 200px;
  }

  .footer-column {
    border-left: none;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    padding: 18px 0 0;
  }

  .footer-column h3 {
    font-size: 16px;
  }

  .footer-bottom {
    margin-top: 20px;
  }
}
