:root {
  --pink-light: #fde8ef;
  --white: #ffff;
  --pink: #B8325A;
  --pink-dark:  #b83b66;
  --text-dark:  #4a2c36;
  --font-main:  'Poppins', sans-serif;
  --1212: #fef0f5; 
  --checker: black; 
  --p: #FFB2C4;
  --hp:#E86A91;
}
body {
   background-color: #fff5f5;
    font-family: Arial, sans-serif;
    color: #b72d5b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
h1, h2, h3 {
  margin: 0;
  font-family: var(--font-main);
}

#id {
  font-family: var(--font-main);
  color: var(--text-dark);
  
}

.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px; /* 10 px 60 px */
  background-color: #E86A91;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.26);
}
.nav-links img {
  display: block;               /* removes the tiny space below inline images */

}
.nav-links a {
  align-items: center;
  display: inline-flex;  
  padding: 0 20px; 
   height: 52px; 
   box-sizing: border-box; 
  background-color:   #bd2e5c;    /* CHANGED: was #a7a7a7 (grey), now the active color */
  color: #ffffff;                 /* red-pink text, replaces var(--white) */
  font-family: Georgia, serif;
  font-size: 16px;
  text-decoration: none;
  border-radius: 15px;
  border-bottom: 4px solid var(--text-dark);
  /* transition: border-color 0.15s, box-shadow 0.15s; */
}
a.Selected{
    background-color: #993055;
  border-bottom-color: color-mix(in srgb, var(--text-dark) 80%, transparent);
  border-bottom: 0px solid var(--text-dark);
  box-shadow: 0 10px 10px rgba(20, 3, 5, 0.26); /* 4th: shadow intensity */

}
.nav-links a:hover {
  background-color: #db3469; 
 
  border-bottom-color: color-mix(in srgb, var(--text-dark) 50%, transparent);
  font-size: 18px;
   border-radius: 20px;
   font-weight: bold;
     padding:10px 20px 10px; 
   box-shadow: none;               /* CHANGED: removes the grey ring on hover */
     
}
.nav-links {
     align-items: center; 
  display: flex;
  margin: 0;                      
  padding: 0;
  gap: 20px;  /* space between each link */
   height: 30px;
  list-style: none;
  font-family: calibri;

}
.logo {
  height: 60px; /*60 px */
}


.drop{
   padding: 10px 0px;
}


html, body {
  margin: 0;
   width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  }
main {
  flex: 1;
}

.footer {
    width: 100%;
    background: #E86A91;
    color: #ffffff;
    padding: 28px 5% 12px;
}


.footer-container {
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: 1.4fr 1.2fr 1.2fr 1.5fr;

    align-items: start;
}


.footer-logo {
    display: flex;
    align-items: center;

    padding-right: 30px;
}

.footer-logo img {
    width: 190px;
    height: auto;
    display: block;

    /* Makes the pink logo appear white */
    filter: brightness(0) invert(1);
}



.footer-column {
    min-height: 80px;

    border-left: 1px solid rgba(255, 255, 255, 0.45);

    padding-left: 35px;
}



.footer-column h3 {
    font-size: 15px;
    font-weight: bold;

    margin-bottom: 8px;
}



.footer-column a {
    display: block;

    color: #ffffff;
    text-decoration: none;

    font-size: 13px;

    line-height: 19px;

    transition: 0.2s;
}

.footer-column a:hover {
    opacity: 0.7;
}



.social-icons {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
}

.social-link img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    display: block;
}

.social-link:hover {
    opacity: 0.8;
}


.contact-column p {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 9px;

    font-size: 12px;
}

.icon {
    width: 18px;

    font-size: 15px;

    text-align: center;
}


.footer-bottom {
    max-width: 1200px;

    margin: 15px auto 0;

    padding-top: 12px;

    border-top: 1px solid rgba(255, 255, 255, 0.45);

    text-align: center;
}

.footer-bottom p {
    font-size: 11px;

    
}

.heart {
    font-size: 16px;

    margin-left: 5px;
}


@media screen and (max-width: 850px) {

    .footer-container {
        grid-template-columns: 1fr 1fr;

        row-gap: 30px;
    }

    .footer-logo {
        padding-right: 0;
    }

    .footer-column {
        padding-left: 25px;
    }

}


@media screen and (max-width: 550px) {
    .footer {
        padding: 30px 25px 15px;
    }
    .footer-container {
        grid-template-columns: 1fr;

        gap: 25px;
    }
    .footer-logo {
        justify-content: center;

        padding-bottom: 5px;
    }
    .footer-logo img {
        width: 200px;
    }
    .footer-column {
        border-left: none;

        border-top: 1px solid rgba(255, 255, 255, 0.35);

        padding-left: 0;

        padding-top: 18px;
    }
    .footer-column h3 {
        font-size: 16px;
    }
    .footer-bottom {
        margin-top: 20px;
    }
}

.banner{ 
  
  background-image: url("BANNER.jpg");
  background-repeat: no-repeat;
   /*background-size: cover;  fills the section without stretching */
     margin: 0 auto;
  width: 1200px;    
  padding : 0px 10px;
  background-position: center;
  height: 400px;   
}



.container {
    width: 100%;
    max-width: 1200px;
    margin: auto;
    padding: 25px;
}


/* FOOD OF THE DAY */

.section-title {
    font-family: Georgia, serif;
    font-size: 32px;
    font-weight: bold;
    text-align: left;
    margin-left: 20px;
    margin-bottom: 20px;
    color: #a92755;
}
.food-row {
    display: flex;
    gap: 25px;
    width: 100%;
    margin-bottom: 35px;
}

.food-card {
    background-color: white;
    border-radius: 15px;
    padding: 10px;
    flex: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.food-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 25px;
    display: block;
}

.food-info {
    padding: 12px 10px;
}

.food-name {
    font-size: 20px;
    font-weight: 500;
    color: #b52e5b;
}

.price {
    font-size: 20px;
    color: #b52e5b;
    margin-top: 2px;
}

.cart-btn {
    background-color: #bd2e5c;
    color: white;
    text-align: center;
    padding: 10px;
    border-radius: 10px;
    font-size: 18px;
    cursor: pointer;
    transition: 0.2s;
}

.cart-btn:hover {
    background-color: #9e234b;
}

/* MENU HEADER */

.menu-header {
    display: flex;
    align-items: center;
    gap: 35px;
    margin: 10px 0 25px 100px;
}

.menu-title {
    font-family: Georgia, serif;
    font-size: 32px;
    font-weight: bold;
    color: #a92755;
}

.menu-tabs {
    display: flex;
    gap: 10px;
}

.tab {
    background-color: #f9cbd8;
    color: #a92755;
    padding: 10px 20px;
    border-radius: 15px;
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    &:hover {
    background-color: #bd2e5c;
    color: white;
}
}

.tab.active {
    background-color: #bd2e5c;
    color: white;
}



/* RESPONSIVE */

@media (max-width: 900px) {

    .food-row {
        flex-wrap: wrap;
    }

    .food-card {
        flex: 1 1 45%;
    }

    .menu-header {
        margin-left: 0;
        flex-wrap: wrap;
    }

}

@media (max-width: 600px) {

    .container {
        padding: 15px;
    }

    .food-row {
        flex-direction: column;
    }

    .food-card {
        width: 100%;
    }

    .food-card img {
        height: 230px;
    }

    .menu-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .menu-tabs {
        flex-wrap: wrap;
    }

}

  

