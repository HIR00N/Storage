:root {
  --pink-light: #fde8ef;
  --white: #ffff;
  --pink: #B8325A;
  --pink-dark:  #b83b66;
  --text-dark:  #4a2c36;
  --font-main:  'Poppins', sans-serif;
  --1212: #fef0f5; 
  --checker: black; 
  --p: #FFB2C4;
}
body {
   background-color: #fff5f5;
    font-family: Arial, sans-serif;
    color: #b72d5b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
h1, h2, h3 {
  margin: 0;
  font-family: var(--font-main);
}

#id {
  font-family: var(--font-main);
  color: var(--text-dark);
  
}

.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px; /* 10 px 60 px */
  background-color: #E86A91;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.26);
}
.nav-links img {
  display: block;               /* removes the tiny space below inline images */

}
.nav-links a {
  align-items: center;
display: inline-flex;  
  padding: 0 20px; 
   height: 52px; 
   box-sizing: border-box; 
  background-color:   #bd2e5c;    /* CHANGED: was #a7a7a7 (grey), now the active color */
  color: #ffffff;                 /* red-pink text, replaces var(--white) */
  font-family: Georgia, serif;
  font-size: 16px;
  text-decoration: none;
  border-radius: 15px;
  border-bottom: 4px solid var(--text-dark);
  transition: border-color 0.15s, box-shadow 0.15s;
}
.nav-links a:hover {
  background-color: #a92755;
  border-bottom-color: color-mix(in srgb, var(--text-dark) 50%, transparent);
 
   box-shadow: none;               /* CHANGED: removes the grey ring on hover */
     
}
.nav-links {
     align-items: center; 
  display: flex;
  margin: 0;                      
  padding: 0;
  gap: 20px;  /* space between each link */
   height: 30px;
  list-style: none;
  font-family: calibri;

}
.logo {
  height: 60px; /*60 px */
}


.drop{
   padding: 10px 0px;
}


html, body {
  margin: 0;
   width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  }
main {
  flex: 1;
}

footer {
  min-height: 15vh;
 background-color: var(--p);
  padding: 20px;

}
.foot-ish{
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 60px;
  background-color: var(--1212);
  list-style: none;
}
.footer-content{
 display: flex; 
  flex-direction: row;
  justify-content: space-evenly; 
  gap: 5px;
  text-align: center;
}
.block {
 font-size: 14px;
  display: inline;
  padding: 20px;
  margin: 10px;
  width: 200px;
  color: var(--white);
}




.container {
    width: 100%;
    max-width: 1200px;
    margin: auto;
    padding: 25px;
}


/* FOOD OF THE DAY */

.section-title {
    font-family: Georgia, serif;
    font-size: 32px;
    font-weight: bold;
    text-align: left;
    margin-left: 20px;
    margin-bottom: 20px;
    color: #a92755;
}
.food-row {
    display: flex;
    gap: 25px;
    width: 100%;
    margin-bottom: 35px;
}

.food-card {
    background-color: white;
    border-radius: 15px;
    padding: 10px;
    flex: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.food-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 25px;
    display: block;
}

.food-info {
    padding: 12px 10px;
}

.food-name {
    font-size: 20px;
    font-weight: 500;
    color: #b52e5b;
}

.price {
    font-size: 20px;
    color: #b52e5b;
    margin-top: 2px;
}

.cart-btn {
    background-color: #bd2e5c;
    color: white;
    text-align: center;
    padding: 10px;
    border-radius: 10px;
    font-size: 18px;
    cursor: pointer;
    transition: 0.2s;
}

.cart-btn:hover {
    background-color: #9e234b;
}

/* MENU HEADER */

.menu-header {
    display: flex;
    align-items: center;
    gap: 35px;
    margin: 10px 0 25px 100px;
}

.menu-title {
    font-family: Georgia, serif;
    font-size: 32px;
    font-weight: bold;
    color: #a92755;
}

.menu-tabs {
    display: flex;
    gap: 10px;
}

.tab {
    background-color: #f9cbd8;
    color: #a92755;
    padding: 10px 20px;
    border-radius: 15px;
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    &:hover {
    background-color: #bd2e5c;
    color: white;
}
}

.tab.active {
    background-color: #bd2e5c;
    color: white;
}



/* RESPONSIVE */

@media (max-width: 900px) {

    .food-row {
        flex-wrap: wrap;
    }

    .food-card {
        flex: 1 1 45%;
    }

    .menu-header {
        margin-left: 0;
        flex-wrap: wrap;
    }

}

@media (max-width: 600px) {

    .container {
        padding: 15px;
    }

    .food-row {
        flex-direction: column;
    }

    .food-card {
        width: 100%;
    }

    .food-card img {
        height: 230px;
    }

    .menu-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .menu-tabs {
        flex-wrap: wrap;
    }

}

  

