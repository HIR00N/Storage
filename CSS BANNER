.hero-banner {
    width: 100%;
    min-height: 340px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    background: #FCE4EC;
    font-family: Arial, sans-serif;
}

.hero-content {
    flex: 1;
    padding: 35px 20px 35px 6%;
    position: relative;
    z-index: 1;
}

.brand-label {
    color: #B8325A;
    font-size: 14px;
    font-weight: bold;
    font-style: italic;
    margin: 0 0 8px;
}

.hero-content h1 {
    color: #A52D55;
    font-family: "Trebuchet MS", sans-serif;
    font-size: clamp(28px, 3.5vw, 44px);
    line-height: 1.18;
    font-weight: 800;
    margin: 0 0 20px;
}

.heart {
    color: #B8325A;
}

.hero-description {
    color: #70444F;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 18px;
}

.order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #E94B72;
    color: #FFFFFF;
    padding: 12px 22px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 16px;
    font-weight: bold;
    transition: 0.3s;
}

.order-btn:hover {
    background: #B8325A;
    transform: translateY(-2px);
}

.utensils {
    font-size: 21px;
}

.arrow {
    font-size: 22px;
}

.hero-image {
    flex: 1.15;
    height: 340px;
    align-self: stretch;
    overflow: hidden;
}

.hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}


@media (max-width: 850px) {
    .hero-banner {
        min-height: 300px;
    }

    .hero-content {
        padding-left: 4%;
    }

    .hero-content h1 {
        font-size: 30px;
    }

    .hero-description {
        font-size: 13px;
    }

    .hero-image {
        height: 300px;
    }
}


@media (max-width: 600px) {
    .hero-banner {
        flex-direction: column;
    }

    .hero-content {
        width: 100%;
        padding: 35px 25px;
    }

    .hero-content h1 {
        font-size: 32px;
    }

    .desktop-break {
        display: none;
    }

    .hero-image {
        width: 100%;
        height: 230px;
        flex: auto;
    }
}
